<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#dbeaff"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="apple-mobile-web-app-title" content="睡眠计算器"><link rel="manifest" href="manifest.json"><link rel="apple-touch-icon" href="icon-180.png"><title>睡眠计算器</title><style>
:root{color-scheme:light;--blue:#3b82f6;--ink:#172554;--muted:#64748b;--line:#dce7f5;--card:rgba(255,255,255,.92);--awake:#f3a34c}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;background:radial-gradient(circle at 10% 8%,#d9eaff 0 10%,transparent 27%),radial-gradient(circle at 90% 20%,#dce8ff 0 8%,transparent 26%),linear-gradient(180deg,#edf6ff,#f6fbff 48%,#eefaf8);min-height:100vh}button,input{font:inherit}button{border:0;cursor:pointer;transition:.18s ease}button:active{transform:translateY(1px)}button:focus-visible,input:focus-visible{outline:3px solid #93c5fd;outline-offset:2px}main{max-width:1180px;margin:0 auto;padding:0 24px 54px}
.hero{position:relative;overflow:hidden;margin:0 -24px 22px;padding:34px 38px 30px;min-height:190px;background:linear-gradient(120deg,#dbeaff,#e9f3ff 52%,#b8d1fa);border-radius:0 0 34px 34px}.hero:before{content:"";position:absolute;width:330px;height:180px;right:-40px;bottom:-35px;background:radial-gradient(ellipse,#3d64a8 0 42%,transparent 43%);opacity:.15;filter:blur(2px)}.hero:after{content:"✦   ·     ✦       ·  ✧";position:absolute;right:54px;top:24px;color:#fff;font-size:17px;letter-spacing:12px;opacity:.85}.hero-content{position:relative;z-index:1;display:flex;align-items:center;gap:20px}.moon{font-size:62px;line-height:1;filter:drop-shadow(0 8px 10px #4772b333)}.hero h1{margin:0;font-size:38px;letter-spacing:.02em;color:#17326b}.hero p{margin:7px 0 0;color:#4f6b9c;font-size:16px}.hero-message{margin-left:auto;max-width:220px;font-size:17px;font-weight:750;color:#fff;text-shadow:0 1px 8px #31578a55;line-height:1.35}.heart{font-size:22px}
.dashboard{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}.metric{background:var(--card);border:1px solid #fff;border-radius:20px;padding:18px;box-shadow:0 10px 30px #416b9a12;min-height:125px}.metric-top{display:flex;align-items:center;gap:10px;color:#365b98;font-weight:700}.metric-icon{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-size:22px;background:#eaf2ff}.metric:nth-child(2) .metric-icon{background:#e8f8f2}.metric:nth-child(3) .metric-icon{background:#eaf3ff}.metric:nth-child(4) .metric-icon{background:#fff1df}.metric-value{font-size:23px;font-weight:800;margin:9px 0 3px;color:#2454b7}.metric:nth-child(2) .metric-value{color:#258a70}.metric:nth-child(4) .metric-value{color:#c86b1a}.metric-note{font-size:12px;color:var(--muted)}
.layout{display:grid;grid-template-columns:1.02fr .98fr;gap:16px;align-items:start}.stack{display:grid;gap:16px}.card{background:var(--card);border:1px solid #fff;border-radius:20px;padding:20px;box-shadow:0 10px 30px #416b9a12;backdrop-filter:blur(8px)}.section-head{display:flex;align-items:center;gap:12px;margin-bottom:15px}.step{flex:0 0 38px;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#4d91ff,#2468db);color:#fff;font-weight:800;font-size:17px;box-shadow:0 5px 12px #3479e633}.section-title{margin:0;font-size:19px}.section-sub{margin:1px 0 0;color:var(--muted);font-size:13px}.row{display:flex;gap:12px;flex-wrap:wrap}.field{flex:1;min-width:0}.date-time{display:block}.date-time input[type="date"]{display:none}label{display:block;font-size:13px;font-weight:750;margin-bottom:6px;color:#243a68}input{width:100%;border:1px solid var(--line);border-radius:12px;padding:10px 11px;background:#fbfdff;color:var(--ink);box-shadow:inset 0 1px 2px #1e3a8a08}.duration-row{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto;gap:7px;align-items:center}.duration-row input{min-width:0}.unit{white-space:nowrap;color:var(--muted);font-size:13px}.control-panel{background:linear-gradient(135deg,#f4f8ff,#eef6ff);border-radius:16px;padding:14px}.compact{padding:7px 11px;margin:8px 0 0;font-size:12px;border-radius:10px;background:#eaf2ff;color:#2563eb;font-weight:750}.small{color:var(--muted);font-size:12px;margin:11px 0 0}.status{padding:10px 14px;border-radius:12px;background:#effaf5;color:#16805f;text-align:center;font-size:13px;font-weight:650}.primary{width:100%;background:linear-gradient(135deg,#3d87f5,#286ce0);color:#fff;padding:12px 14px;border-radius:12px;font-weight:800;box-shadow:0 7px 16px #2e72e533;margin-top:9px}.primary:hover{filter:brightness(1.03);transform:translateY(-1px)}.secondary{background:#eef3f9;color:#465b78;padding:12px 14px;border-radius:12px;font-weight:750}.danger{background:#fff0f0;color:#c24141}.wake-item,.history-item{border:1px solid #e2ebf6;background:#f8fbff;border-radius:14px;padding:12px;margin:9px 0}.item-head{display:flex;justify-content:space-between;align-items:center;gap:10px}.item-head strong{font-size:13px}.add-wake{width:100%;border:1px dashed #b8cce8;background:#fbfdff;color:#2f74dd;padding:10px;border-radius:12px;font-weight:750;margin-top:7px}.result{background:linear-gradient(135deg,#edf5ff,#e8f1ff);border-radius:16px;text-align:center;margin-top:12px;padding:15px;border:1px solid #dce9fb}.big{color:#2159c8;font-size:31px;font-weight:850;margin:3px}.detail{color:#536887;font-size:13px}.two-buttons{display:grid;grid-template-columns:1fr 1fr;gap:10px}.two-buttons button{margin-top:10px}
.timeline{height:48px;display:flex;overflow:hidden;border-radius:13px;background:#dbe6f4;box-shadow:inset 0 1px 3px #31537a16}.segment{min-width:2px;height:100%;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}.segment-label{font-size:11px;font-weight:750;color:#fff;text-shadow:0 1px 2px #17376a80;white-space:nowrap;padding:0 5px;pointer-events:none}.segment.sleep .segment-label{display:block}.segment.awake .segment-label{display:none}.timeline-details{display:flex;flex-direction:column;gap:6px;margin-top:9px}.timeline-detail{display:flex;align-items:center;gap:7px;background:#f7faff;border-radius:9px;padding:6px 9px;font-size:12px;color:#526987}.timeline-detail .dot{width:8px;height:8px;border-radius:50%;background:#5b88e5;flex:0 0 auto}.timeline-detail strong{color:#294979}.sleep{background:linear-gradient(90deg,#5d8fe9,#477ce0)}.awake{background:#f3a34c}.labels{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--muted);margin:7px 0}.legend{display:flex;justify-content:center;gap:18px;color:#60718c;font-size:12px;margin-top:6px}.legend i{display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:5px;vertical-align:-1px}.legend .s{background:#5b88e5}.legend .a{background:#f3a34c}.stats{display:flex;gap:9px;margin-top:13px}.stat{flex:1;text-align:center;background:#f7faff;border-radius:12px;padding:10px 6px;font-size:12px;color:#5e718f}.stat strong{display:block;color:#203c72;font-size:16px;margin-top:2px}.history-head{display:flex;justify-content:space-between;align-items:center;gap:10px}.history-count{font-size:12px;color:var(--muted)}.history-meta{color:var(--muted);font-size:12px;margin-top:3px}.history-summary{background:#f1f7ff;border-radius:12px;padding:9px 11px;color:#49678f;font-size:12px;margin-bottom:10px}.empty{color:var(--muted);text-align:center;margin:14px 8px;font-size:13px}.tip{background:linear-gradient(135deg,#edf9f5,#e4f5ef)}.tip-content{display:flex;align-items:center;justify-content:space-between;gap:14px}.tip-title{font-size:16px;font-weight:800;color:#22836c}.cat{font-size:50px;line-height:1}.footer{text-align:right;color:#7b91b1;font-style:italic;font-size:14px;padding:4px 6px 0}.hidden{display:none!important}
.data-tools{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}.data-tool{display:flex;align-items:center;gap:10px;text-align:left;background:#f7faff;border:1px solid #dce8f7;border-radius:13px;padding:11px 12px;color:#29466f;font-weight:750}.data-tool .tool-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:#eaf2ff;font-size:18px;flex:0 0 auto}.data-tool:hover{background:#f0f6ff;transform:translateY(-1px)}.data-tool.danger-tool{background:#fff7f7;border-color:#f5dddd;color:#b23b3b}.data-tool.danger-tool .tool-icon{background:#ffe9e9}.data-tool small{display:block;color:var(--muted);font-size:11px;font-weight:500;margin-top:1px}.data-note{margin-top:10px;padding:10px 12px;border-radius:11px;background:#f4f8fc;color:#60718c;font-size:12px}.data-file{display:none}@media(max-width:520px){.data-tools{grid-template-columns:1fr}}

@media(max-width:900px){main{padding:0 14px 40px}.hero{margin:0 -14px 18px;padding:28px 24px}.dashboard{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:1fr}.hero-message{display:none}}@media(max-width:520px){main{padding:0 10px 34px}.hero{margin:0 -10px 14px;padding:22px 17px 24px;border-radius:0 0 24px 24px;min-height:145px}.moon{font-size:48px}.hero h1{font-size:29px}.hero p{font-size:13px}.dashboard{gap:9px}.metric{padding:13px;border-radius:16px;min-height:112px}.metric-icon{width:34px;height:34px;font-size:18px}.metric-value{font-size:18px}.metric-note{font-size:11px}.card{padding:15px;border-radius:17px}.section-title{font-size:17px}.section-sub{font-size:12px}.step{width:34px;height:34px;flex-basis:34px;font-size:15px}.stats{gap:6px}.stat{padding:8px 3px}.stat strong{font-size:14px}.two-buttons{grid-template-columns:1fr}.footer{text-align:center}.field{min-width:0}}
.settings-card{margin-top:0}.settings-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 13px;background:#f7faff;border-radius:11px;margin-top:7px;color:#405a80;font-size:13px}.settings-row strong{color:#2459b8;font-size:14px}.setting-muted{color:#7184a0;text-align:right}</style></head><body><main><header class="hero"><div class="hero-content"><div class="moon">🌙</div><div><h1>睡眠计算器</h1><p>记录睡眠、起夜与实际睡眠时长，保持更好的作息</p></div><div class="hero-message">好的睡眠<br>是明天更好的自己 <span class="heart">♥</span></div></div></header>
<section class="dashboard"><div class="metric"><div class="metric-top"><span class="metric-icon">🎯</span>长期睡眠目标</div><div class="metric-value" id="metricLongTerm">8小时</div><div class="metric-note">你的长期睡眠基准</div></div><div class="metric"><div class="metric-top"><span class="metric-icon">⚖️</span>累计睡眠盈亏</div><div class="metric-value" id="metricBalance">—</div><div class="metric-note">根据全部历史记录计算</div></div><div class="metric"><div class="metric-top"><span class="metric-icon">🛏️</span>下一次目标睡眠</div><div class="metric-value" id="metricNext">—</div><div class="metric-note">长期目标 ± 累计睡眠盈亏</div></div><div class="metric"><div class="metric-top"><span class="metric-icon">📊</span>已记录</div><div class="metric-value" id="metricCount">0次</div><div class="metric-note" id="metricTotal">还没有完成记录</div></div></section>
<div class="layout"><div class="stack">
<section class="card"><div class="section-head"><div class="step">1</div><div><h2 class="section-title">睡眠设置</h2><p class="section-sub">设置入睡时间和本次目标睡眠时长</p></div></div><div class="control-panel"><div class="row"><div class="field"><label>首次入睡时间</label><div class="date-time"><input type="date" id="sleepStartDate" aria-label="首次入睡日期"><input type="time" id="sleepStart" aria-label="首次入睡时间"></div></div><div class="field"><label>目标睡眠时间</label><div class="duration-row"><input type="number" id="targetSleepHours" value="8" min="0" max="24" step="1" aria-label="目标睡眠小时"><span class="unit">小时</span><input type="number" id="targetSleepMinutes" value="0" min="0" max="59" step="1" aria-label="目标睡眠分钟"><span class="unit">分钟</span></div></div></div><button type="button" class="compact" id="nowButton">🕐 使用当前时间</button></div><div style="margin-top:14px"><label>长期睡眠目标</label><div class="duration-row"><input type="number" id="longTermHours" value="8" min="0" max="24" step="1"><span class="unit">小时</span><input type="number" id="longTermMinutes" value="0" min="0" max="59" step="1"><span class="unit">分钟</span></div></div><p class="small">下一次目标会根据全部历史记录累计调整：之前多睡的时间会抵扣，之前少睡的时间会补回来。</p></section>
<section class="card"><div class="section-head"><div class="step">2</div><div><h2 class="section-title">中间起夜记录</h2><p class="section-sub">记录每次醒来和再次入睡的时间</p></div></div><div id="wakeList"></div><button type="button" class="add-wake" id="addWake">＋ 添加一次起夜</button><p class="small">可添加多次，系统会自动从总睡眠时间中扣除清醒时间。</p></section>
<section class="card"><div class="section-head"><div class="step">3</div><div><h2 class="section-title">计算建议起床时间</h2><p class="section-sub">根据入睡时间、目标睡眠和起夜时间计算</p></div></div><button type="button" class="primary" id="calculateWake">计算起床时间</button><div id="wakeResult" class="result hidden"><div>为了睡满目标时间，你应该在</div><div id="recommendedWake" class="big"></div><div id="wakeDetail" class="detail"></div></div></section>
<section class="card"><div class="section-head"><div class="step">4</div><div><h2 class="section-title">计算实际睡眠</h2><p class="section-sub">输入最终起床时间，日期会根据你输入时间的实际日期自动记录</p></div></div><label>最终起床时间</label><div class="date-time"><input type="date" id="finalWakeDate" aria-label="最终起床日期"><input type="time" id="finalWake" aria-label="最终起床时间"></div><button type="button" class="primary" id="calculateActual">计算实际睡眠时长</button><div id="sleepResult" class="result hidden"><div>你的实际睡眠时间</div><div id="actualSleep" class="big"></div><div id="sleepDetail" class="detail"></div></div><div class="two-buttons"><button type="button" class="primary" id="saveCompleted">💾 保存本次记录</button><button type="button" class="secondary" id="clearCurrent">↻ 清空当前记录</button></div></section><div id="saveStatus" class="status">💾 当前记录会自动保存到此浏览器</div></div>
<div class="stack"><section class="card"><div class="section-head"><div class="step">☾</div><div><h2 class="section-title">睡眠时间轴</h2><p class="section-sub">直观展示睡眠与清醒的时间分布</p></div></div><div id="timelineEmpty" class="empty">填写入睡时间和最终起床时间后，这里将显示完整时间轴。</div><div id="timelineContent" class="hidden"><div class="labels"><span id="timelineStart"></span><span>睡眠 / 清醒</span><span id="timelineEnd"></span></div><div id="timelineBar" class="timeline"></div><div id="timelineDetails" class="timeline-details"></div><div class="legend"><span><i class="s"></i>睡眠</span><span><i class="a"></i>清醒／起夜</span></div><div class="stats"><div class="stat">实际睡眠<strong id="timelineSleep">--</strong></div><div class="stat">清醒时间<strong id="timelineAwake">--</strong></div><div class="stat">总经过时间<strong id="timelineTotal">--</strong></div></div></div></section>
<section class="card"><div class="history-head"><div class="section-head" style="margin:0"><div class="step">▥</div><div><h2 class="section-title">已完成的睡眠记录</h2><p class="section-sub">长期目标会根据这些记录累计调整</p></div></div><span id="historyCount" class="history-count"></span></div><div id="historySummary" class="history-summary hidden"></div><div id="historyList"></div></section>
<section class="card"><div class="section-head"><div class="step">⚙</div><div><h2 class="section-title">数据管理</h2><p class="section-sub">备份、恢复或导出你的睡眠数据</p></div></div><div class="data-tools"><button type="button" class="data-tool" id="exportData"><span class="tool-icon">📦</span><span>导出全部数据<small>JSON 备份，可完整恢复</small></span></button><button type="button" class="data-tool" id="importData"><span class="tool-icon">📥</span><span>导入数据<small>从 JSON 备份恢复</small></span></button><button type="button" class="data-tool" id="exportCsv"><span class="tool-icon">📊</span><span>导出历史记录<small>CSV，可用 Excel 打开</small></span></button><button type="button" class="data-tool danger-tool" id="clearHistory"><span class="tool-icon">🗑️</span><span>清空历史记录<small>当前记录不会删除</small></span></button></div><input class="data-file" type="file" id="importFile" accept="application/json,.json"><div class="data-note">💡 数据目前保存在本设备的浏览器中。现在睡眠记录会同时保存日期和时间，因此可以正确计算跨天、跨 24 小时的睡眠（例如昨天 14:00 到今天 17:00 = 27 小时）。建议定期导出 JSON 备份，换手机或清除浏览器数据后可重新导入。</div></section><section class="card settings-card"><div class="section-head"><div class="step">⚙</div><div><h2 class="section-title">设置</h2><p class="section-sub">应用信息与版本</p></div></div><div class="settings-row"><span>应用版本</span><strong>V7.4</strong></div><div class="settings-row"><span>数据存储</span><span class="setting-muted">本设备浏览器本地存储</span></div></section><section class="card tip"><div class="tip-content"><div><div class="tip-title">🌿 小贴士</div><div class="small">规律的作息不是束缚，而是给生活更多的可能。</div></div><div class="cat">😴</div></div></section><div class="footer">Sleep Well, Live Better ♡</div></div></div></main><script>
(() => {
  'use strict';
  const CURRENT_KEY = 'sleepCalculator.current.v3', HISTORY_KEY = 'sleepCalculator.history.v3';
  const $ = id => document.getElementById(id);
  const timeToMinutes = value => { if (!/^\d{2}:\d{2}$/.test(value || '')) return null; const [h,m]=value.split(':').map(Number); return h*60+m; };
  const duration = minutes => { minutes=Math.round(minutes); const h=Math.floor(minutes/60), m=minutes%60; return h ? (m ? `${h}小时${m}分钟` : `${h}小时`) : `${m}分钟`; };
  const clock = minutes => { const d=new Date(minutes*60000); return `${d.getMonth()+1}/${d.getDate()} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`; };
  // 时间控件不含日期。若最终起床钟点早于入睡钟点，就把这次睡眠归到昨天（入睡日期）。
  const dateTimeToMinutes = (dateValue,timeValue) => { if(!/^\d{4}-\d{2}-\d{2}$/.test(dateValue||'') || timeToMinutes(timeValue)===null) return null; const d=new Date(`${dateValue}T${timeValue}:00`); return Number.isNaN(d.getTime()) ? null : Math.floor(d.getTime()/60000); };
  const minutesToDate = minutes => { const d=new Date(minutes*60000); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; };
  const minutesToTime = minutes => { const d=new Date(minutes*60000); return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`; };
  const dateTimeText = minutes => { const d=new Date(minutes*60000); return `${d.getMonth()+1}/${d.getDate()} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`; };
  const elapsedClock = (start,minutes) => { const diff=minutes-start; if(Math.abs(diff)<24*60) return minutesToTime(minutes); return dateTimeText(minutes); };
  function todayDate(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
  function nowTime() { const d=new Date(); return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`; }
  function shiftDate(dateValue,days){const d=new Date(`${dateValue}T00:00:00`);d.setDate(d.getDate()+days);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
  function setDefaultInputDates(){const today=todayDate(); if(!$('sleepStartDate').value)$('sleepStartDate').value=today; if(!$('finalWakeDate').value)$('finalWakeDate').value=today;}
  function syncWakeDates(row){const wd=row.querySelector('.wake-date'),ad=row.querySelector('.again-date'),wt=row.querySelector('.wake-time'),at=row.querySelector('.again-time'); const base=wd.value||todayDate(); if(!wd.value)wd.value=base; if(!ad.value)ad.value=base; if(wt.value&&at.value&&timeToMinutes(at.value)<timeToMinutes(wt.value))ad.value=shiftDate(base,1); else if(at.value)ad.value=base;}
  function syncMainDates(){setDefaultInputDates(); const start=timeToMinutes($('sleepStart').value), end=timeToMinutes($('finalWake').value); if($('finalWake').value){ if(start!==null && end<start)$('finalWakeDate').value=shiftDate($('sleepStartDate').value||todayDate(),1); else if(!$('finalWakeDate').dataset.userSet)$('finalWakeDate').value=todayDate(); }}
  function setStatus(text) { $('saveStatus').textContent=text; }
  function wakeRows() { return [...document.querySelectorAll('.wake-item')]; }
  function addWake(wake='', again='', wakeDate='', againDate='') { const item=document.createElement('div'); item.className='wake-item'; const fallback=todayDate(); item.innerHTML=`<div class="item-head"><strong>起夜记录</strong><button type="button" class="danger compact remove-wake">删除</button></div><div class="row"><div class="field"><label>醒来时间</label><div class="date-time"><input type="date" class="wake-date" value="${wakeDate||fallback}" aria-label="醒来日期"><input type="time" class="wake-time" value="${wake}"></div></div><div class="field"><label>再次入睡时间</label><div class="date-time"><input type="date" class="again-date" value="${againDate||wakeDate||fallback}" aria-label="再次入睡日期"><input type="time" class="again-time" value="${again}"></div></div></div>`; $('wakeList').append(item); item.querySelector('.remove-wake').addEventListener('click',()=>{item.remove(); saveCurrent();}); item.querySelectorAll('input').forEach(input=>input.addEventListener('input',()=>{syncWakeDates(item);saveCurrent();})); }
  function collectPeriods() { const result=[]; for (const [i,row] of wakeRows().entries()) { const wake=dateTimeToMinutes(row.querySelector('.wake-date').value,row.querySelector('.wake-time').value), again=dateTimeToMinutes(row.querySelector('.again-date').value,row.querySelector('.again-time').value); if(wake===null && again===null) continue; if(wake===null || again===null) throw new Error(`第 ${i+1} 次起夜的日期或时间没有填写完整`); result.push({wake,again}); } return result; }
  function normalize(start, periods) { return periods.map(p=>({wake:p.wake,again:p.again})); }
  function readState() { return {sleepStartDate:$('sleepStartDate').value,sleepStart:$('sleepStart').value,targetSleepHours:$('targetSleepHours').value, targetSleepMinutes:$('targetSleepMinutes').value, longTermHours:$('longTermHours').value, longTermMinutes:$('longTermMinutes').value, finalWakeDate:$('finalWakeDate').value, finalWake:$('finalWake').value, wakePeriods:wakeRows().map(row=>({wake:row.querySelector('.wake-time').value,wakeDate:row.querySelector('.wake-date').value,again:row.querySelector('.again-time').value,againDate:row.querySelector('.again-date').value}))}; }
  function saveCurrent() { localStorage.setItem(CURRENT_KEY,JSON.stringify(readState())); setStatus('💾 当前记录已自动保存'); }
  function restoreCurrent() { try { const data=JSON.parse(localStorage.getItem(CURRENT_KEY)||'null'); if (!data) return false; const legacyStart=data.sleepStart||''; const legacyEnd=data.finalWake||''; let startDate=data.sleepStartDate||todayDate(), endDate=data.finalWakeDate||todayDate(); if(!data.sleepStartDate && legacyStart && legacyEnd && timeToMinutes(legacyEnd)<timeToMinutes(legacyStart)){const d=new Date(`${startDate}T00:00:00`);d.setDate(d.getDate()+1);endDate=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;} $('sleepStartDate').value=startDate; $('sleepStart').value=legacyStart; $('targetSleepHours').value=data.targetSleepHours ?? '8'; $('targetSleepMinutes').value=data.targetSleepMinutes ?? '0'; $('longTermHours').value=data.longTermHours ?? '8'; $('longTermMinutes').value=data.longTermMinutes ?? '0'; $('finalWakeDate').value=endDate; $('finalWake').value=legacyEnd; (data.wakePeriods||[]).forEach(p=>addWake(p.wake,p.again,p.wakeDate||startDate,p.againDate||p.wakeDate||startDate)); setStatus('📂 已恢复当前记录'); return true; } catch { localStorage.removeItem(CURRENT_KEY); return false; } }
  function actualData() { const start=dateTimeToMinutes($('sleepStartDate').value,$('sleepStart').value), end=dateTimeToMinutes($('finalWakeDate').value,$('finalWake').value); if(start===null || end===null) throw new Error('请先填写首次入睡和最终起床的日期与时间'); if(end<=start) throw new Error('最终起床时间必须晚于首次入睡时间，请检查日期和时间'); const periods=normalize(start,collectPeriods()).filter(p=>p.wake<end); let awake=0, cursor=start; for(const p of periods){ if(p.wake<cursor) throw new Error('起夜时间顺序有重叠，请按实际发生顺序填写日期和时间'); if(p.again<=p.wake) throw new Error('再次入睡时间必须晚于醒来时间'); if(p.again>end) throw new Error('再次入睡时间不能晚于最终起床时间'); awake+=p.again-p.wake; cursor=p.again; } return {start,end,periods,awake,sleep:end-start-awake}; }
  function renderTimeline(data) { const bar=$('timelineBar'), details=$('timelineDetails'); bar.replaceChildren(); details.replaceChildren(); const all=[{kind:'sleep',from:data.start,to:data.periods[0]?.wake??data.end}]; data.periods.forEach((p,i)=>{all.push({kind:'awake',from:p.wake,to:p.again}); all.push({kind:'sleep',from:p.again,to:data.periods[i+1]?.wake??data.end});}); const total=data.end-data.start; let sleepNo=0; all.filter(s=>s.to>s.from).forEach(s=>{const mins=s.to-s.from; const el=document.createElement('div'); el.className=`segment ${s.kind}`; el.style.flex=`${mins} 0 0`; el.title=`${s.kind==='sleep'?'睡眠':'清醒'}：${dateTimeText(s.from)} → ${dateTimeText(s.to)}（${duration(mins)}）`; if(s.kind==='sleep'){ sleepNo++; const label=document.createElement('span'); label.className='segment-label'; label.textContent=duration(mins); el.append(label); const row=document.createElement('div'); row.className='timeline-detail'; row.innerHTML=`<span class="dot"></span><span>第${sleepNo}段睡眠：<strong>${dateTimeText(s.from)} → ${dateTimeText(s.to)}</strong> · ${duration(mins)}</span>`; details.append(row); } bar.append(el);}); $('timelineStart').textContent=clock(data.start); $('timelineEnd').textContent=clock(data.end); $('timelineSleep').textContent=duration(data.sleep); $('timelineAwake').textContent=duration(data.awake); $('timelineTotal').textContent=duration(total); $('timelineEmpty').classList.add('hidden'); $('timelineContent').classList.remove('hidden'); }
  function calculateActual() { try { const data=actualData(); if(data.sleep<0) throw new Error('起夜时间不能超过总经过时间'); $('actualSleep').textContent=duration(data.sleep); $('sleepDetail').textContent=`总经过 ${duration(data.end-data.start)}，其中清醒／起夜 ${duration(data.awake)}。`; $('sleepResult').classList.remove('hidden'); renderTimeline(data); saveCurrent(); return data; } catch(error) { alert(error.message); return null; } }
  function getTargetMinutes(){const h=Number($('targetSleepHours').value),m=Number($('targetSleepMinutes').value);if(!Number.isInteger(h)||h<0||h>24||!Number.isInteger(m)||m<0||m>59||(h===0&&m===0))throw new Error('请输入正确的目标睡眠时间');return h*60+m;}
  function longTermMinutes(){const h=Number($('longTermHours').value),m=Number($('longTermMinutes').value);if(!Number.isInteger(h)||h<0||h>24||!Number.isInteger(m)||m<0||m>59||(h===0&&m===0))throw new Error('请输入正确的长期睡眠目标');return h*60+m;}
  function parseDuration(t){const m=String(t||'').match(/^(?:(\d+)小时)?(?:(\d+)分钟)?$/);return m&& (m[1]||m[2]) ? Number(m[1]||0)*60+Number(m[2]||0):null;}
  function setTargetInputs(n){n=Math.max(1,Math.min(1440,Math.round(n)));$('targetSleepHours').value=Math.floor(n/60);$('targetSleepMinutes').value=n%60;}
  function adaptiveTarget() {
    const entries=history();
    if(!entries.length) return null;
    const target=longTermMinutes();
    const values=entries.map(x=>parseDuration(x.sleepDuration)).filter(v=>v!==null);
    if(!values.length) return null;

    // 累计睡眠盈亏：
    // actual > target = 多睡，下一次减少同等时间；
    // actual < target = 少睡，下一次增加同等时间。
    const balance=values.reduce((sum,actual)=>sum+(actual-target),0);
    return Math.max(1, Math.min(1440, Math.round(target-balance)));
  }
  function calculateWake(){try{const start=dateTimeToMinutes($('sleepStartDate').value,$('sleepStart').value),target=getTargetMinutes();if(start===null)throw new Error('请填写首次入睡日期与时间');const periods=normalize(start,collectPeriods()),awake=periods.reduce((s,p)=>s+p.again-p.wake,0),wake=start+target+awake;$('recommendedWake').textContent=dateTimeText(Math.round(wake));$('wakeDetail').textContent=`本次目标 ${duration(target)}；已记录清醒时间 ${duration(awake)}。`;$('wakeResult').classList.remove('hidden');saveCurrent();}catch(e){alert(e.message);}}
  function history() { try { const list=JSON.parse(localStorage.getItem(HISTORY_KEY)||'[]'); return Array.isArray(list)?list:[]; } catch { return []; } }

  function updateDashboard(){const entries=history(),values=entries.map(x=>parseDuration(x.sleepDuration)).filter(v=>v!==null);try{$('metricLongTerm').textContent=duration(longTermMinutes());}catch(e){$('metricLongTerm').textContent='—';}$('metricCount').textContent=`${values.length}次`;$('metricTotal').textContent=values.length?`共 ${duration(values.reduce((a,b)=>a+b,0))} 睡眠`:'还没有完成记录';if(values.length){try{const target=longTermMinutes(),balance=values.reduce((s,a)=>s+(a-target),0);$('metricBalance').textContent=balance===0?'0分钟':balance>0?`+${duration(balance)}`:`-${duration(-balance)}`;$('metricNext').textContent=duration(adaptiveTarget());}catch(e){$('metricBalance').textContent='—';$('metricNext').textContent='—';}}else{$('metricBalance').textContent='—';$('metricNext').textContent='—';}const hc=$('historyCount');if(hc)hc.textContent=values.length?`共 ${values.length} 条记录`:'';}
  function formatMonthDay(value){const m=String(value||'').match(/^(?:\d{4}[\/-])?(\d{1,2})[\/-](\d{1,2})/);return m?`${Number(m[1])}/${Number(m[2])}`:String(value||'');} function renderHistory() {
    const list=$('historyList'), entries=history();
    list.replaceChildren();
    const summary=$('historySummary');
    if(summary){
      const values=entries.map(x=>parseDuration(x.sleepDuration)).filter(v=>v!==null);
      if(!values.length){
        summary.textContent=''; summary.classList.add('hidden');
      } else {
        try {
          const target=longTermMinutes();
          const balance=values.reduce((sum,actual)=>sum+(actual-target),0);
          const balanceText=balance===0?'累计无盈亏':balance>0?`累计多睡 ${duration(balance)}`:`累计少睡 ${duration(-balance)}`;
          summary.textContent=`共 ${values.length} 次记录 · ${balanceText} · 下一次目标 ${duration(adaptiveTarget())}`; summary.classList.remove('hidden');
        } catch(e) {
          summary.textContent=`共 ${values.length} 次记录`; summary.classList.remove('hidden'); summary.classList.remove('hidden');
        }
      }
    }
    if(!entries.length){list.innerHTML='<p class="empty">还没有已完成的睡眠记录。</p>';updateDashboard();return;}
    entries.forEach(entry=>{
      const item=document.createElement('div');
      item.className='history-item';
      item.innerHTML=`<div class="item-head"><strong>📅 ${formatMonthDay(entry.date)} · ${entry.sleepStart} → ${entry.finalWake}</strong><button type="button" class="danger compact">删除</button></div><div class="history-meta">实际睡眠 ${entry.sleepDuration} · 清醒／起夜 ${entry.awakeDuration} · ${entry.wakeCount} 次起夜</div>`;
      item.querySelector('button').addEventListener('click',()=>{
        if(confirm('确定删除这条已完成的睡眠记录吗？')){
          localStorage.setItem(HISTORY_KEY,JSON.stringify(history().filter(x=>x.id!==entry.id)));
          const next=adaptiveTarget();
          if(next!==null) setTargetInputs(next);
          renderHistory();
        }
      });
      list.append(item);
    });
    updateDashboard();
  }
  function saveCompleted() { const data=calculateActual(); if(!data) return; const startDate=$('sleepStartDate').value.replaceAll('-','/'); const entry={id:`${Date.now()}-${Math.random()}`,date:startDate,sleepStart:$('sleepStart').value,finalWake:$('finalWake').value,sleepStartDate:$('sleepStartDate').value,finalWakeDate:$('finalWakeDate').value,sleepDuration:duration(data.sleep),awakeDuration:duration(data.awake),wakeCount:data.periods.length}; const entries=history(); const duplicate=entries.some(x=>x.date===entry.date&&x.sleepStart===entry.sleepStart&&x.finalWake===entry.finalWake); if(duplicate){alert('这条睡眠记录已经保存过了。');return;} entries.unshift(entry); localStorage.setItem(HISTORY_KEY,JSON.stringify(entries)); const next=adaptiveTarget(); if(next!==null){setTargetInputs(next); saveCurrent(); const target=longTermMinutes();
      const vals=history().map(x=>parseDuration(x.sleepDuration)).filter(v=>v!==null);
      const balance=vals.reduce((sum,actual)=>sum+(actual-target),0);
      const balanceText=balance===0?'刚好达到长期目标':balance>0?`累计多睡 ${duration(balance)}`:`累计少睡 ${duration(-balance)}`;
      setStatus(`✅ 本次睡眠已保存；${balanceText}；下一次目标 ${duration(next)}`);
      alert(`本次实际睡眠 ${duration(data.sleep)}。
${balanceText}。
长期目标 ${duration(target)}。
下一次目标睡眠时间调整为 ${duration(next)}。`);} renderHistory(); }
  function downloadFile(name,content,type){const blob=new Blob([content],{type});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);}
  function exportData(){const payload={app:'sleep-calculator',version:7.5,exportedAt:new Date().toISOString(),current:null,history:history()};try{payload.current=JSON.parse(localStorage.getItem(CURRENT_KEY)||'null');}catch{}downloadFile(`sleep-calculator-backup-${new Date().toISOString().slice(0,10)}.json`,JSON.stringify(payload,null,2),'application/json;charset=utf-8');setStatus('📦 数据备份已导出');}
  function normalizeImportedHistory(raw){if(!Array.isArray(raw))throw new Error('备份中的历史记录格式不正确');return raw.filter(x=>x&&typeof x==='object').map(x=>({id:String(x.id||`${Date.now()}-${Math.random()}`),date:String(x.date||''),sleepStart:String(x.sleepStart||''),sleepStartDate:String(x.sleepStartDate||''),finalWake:String(x.finalWake||''),finalWakeDate:String(x.finalWakeDate||''),sleepDuration:String(x.sleepDuration||''),awakeDuration:String(x.awakeDuration||'0分钟'),wakeCount:Number.isFinite(Number(x.wakeCount))?Number(x.wakeCount):0})).filter(x=>x.date&&x.sleepStart&&x.finalWake&&parseDuration(x.sleepDuration)!==null);}
  function importDataFromText(text){let data;try{data=JSON.parse(text);}catch{throw new Error('无法读取备份：JSON 文件格式错误。');}const importedHistory=normalizeImportedHistory(data.history);let importedCurrent=null;if(data.current!==null&&data.current!==undefined){if(typeof data.current!=='object')throw new Error('备份中的当前记录格式不正确');importedCurrent=data.current;}if(!confirm(`准备导入 ${importedHistory.length} 条历史记录。\n\n导入后会覆盖当前设备上的历史记录和当前记录。\n\n确定继续吗？`))return;localStorage.setItem(HISTORY_KEY,JSON.stringify(importedHistory));if(importedCurrent)localStorage.setItem(CURRENT_KEY,JSON.stringify(importedCurrent));else localStorage.removeItem(CURRENT_KEY);location.reload();}
  function exportCsv(){const entries=history();if(!entries.length){alert('目前没有可导出的历史记录。');return;}const header=['日期','首次入睡日期','首次入睡','最终起床日期','最终起床','实际睡眠','清醒/起夜','起夜次数'];const rows=entries.map(x=>[x.date,x.sleepStartDate||x.date.replaceAll('/','-'),x.sleepStart,x.finalWakeDate||'',x.finalWake,x.sleepDuration,x.awakeDuration,x.wakeCount]);const csv='\ufeff'+[header,...rows].map(row=>row.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(',')).join('\r\n');downloadFile(`sleep-history-${new Date().toISOString().slice(0,10)}.csv`,csv,'text/csv;charset=utf-8');setStatus('📊 历史记录 CSV 已导出');}
  function clearHistory(){const count=history().length;if(!count){alert('目前没有历史记录。');return;}if(!confirm(`确定删除全部 ${count} 条历史记录吗？\n\n此操作无法撤销。建议先导出 JSON 备份。`))return;localStorage.removeItem(HISTORY_KEY);renderHistory();const target=longTermMinutes();setTargetInputs(target);saveCurrent();setStatus('🗑️ 全部历史记录已清空');}
  function clearCurrent() { if(!confirm('确定清空当前记录吗？已完成的历史记录不会删除。'))return; localStorage.removeItem(CURRENT_KEY); $('sleepStart').value=''; $('sleepStartDate').value=todayDate(); $('targetSleepHours').value='8'; $('targetSleepMinutes').value='0'; $('longTermHours').value='8'; $('longTermMinutes').value='0'; $('finalWake').value=''; $('finalWakeDate').value=todayDate(); $('wakeList').replaceChildren(); $('wakeResult').classList.add('hidden'); $('sleepResult').classList.add('hidden'); $('timelineContent').classList.add('hidden'); $('timelineEmpty').classList.remove('hidden'); setStatus('🗑️ 当前记录已清空'); }
  $('nowButton').addEventListener('click',()=>{$('sleepStartDate').value=todayDate();$('sleepStartDate').dataset.userSet='1';$('sleepStart').value=nowTime();$('finalWakeDate').dataset.userSet='';syncMainDates();saveCurrent();}); $('exportData').addEventListener('click',exportData); $('importData').addEventListener('click',()=>$('importFile').click()); $('importFile').addEventListener('change',e=>{const file=e.target.files?.[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{importDataFromText(String(reader.result||''));}catch(err){alert(err.message||'导入失败');}e.target.value='';};reader.readAsText(file);}); $('exportCsv').addEventListener('click',exportCsv); $('clearHistory').addEventListener('click',clearHistory); $('addWake').addEventListener('click',()=>{addWake();saveCurrent();}); $('calculateWake').addEventListener('click',calculateWake); $('calculateActual').addEventListener('click',calculateActual); $('saveCompleted').addEventListener('click',saveCompleted); $('clearCurrent').addEventListener('click',clearCurrent); ['sleepStart','targetSleepHours','targetSleepMinutes','longTermHours','longTermMinutes','finalWake'].forEach(id=>$(id).addEventListener('input',()=>{syncMainDates();saveCurrent();updateDashboard();renderHistory();})); $('sleepStartDate').addEventListener('input',()=>{ $('sleepStartDate').dataset.userSet='1'; syncMainDates(); saveCurrent(); }); $('finalWakeDate').addEventListener('input',()=>{ $('finalWakeDate').dataset.userSet='1'; saveCurrent(); });
  if(!restoreCurrent()){ $('sleepStartDate').value=todayDate(); $('sleepStart').value=nowTime(); $('finalWakeDate').value=todayDate(); } try{const next=adaptiveTarget();if(next!==null)setTargetInputs(next);}catch(e){} renderHistory(); updateDashboard();
})();
</script><script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));}</script></body></html>